PORT=3001

DATABASE_URL=postgresql://user:password@localhost:5432/sitenova

JWT_SECRET=replace-with-a-long-random-string

# Required for performance measurement (server/src/integrations/pagespeed.ts).
# Get a free key from Google Cloud Console with the "PageSpeed Insights API"
# enabled. Without a key, PSI's anonymous quota is 0 requests/day.
PAGESPEED_API_KEY=replace-with-a-real-pagespeed-insights-api-key

# Selects the AI Performance analysis provider (server/src/integrations/ai/).
# "mock"   -- deterministic, zero-network, zero-cost. Default if unset --
#             safe for local development without an OpenAI API key.
# "openai" -- real OpenAI Responses API calls. Requires OPENAI_API_KEY below.
# Any other value fails safely with a configuration error when AI analysis
# is actually requested (the server itself still starts normally).
#
# Stage 16.7: when NODE_ENV=production, an UNSET AI_PROVIDER is refused
# (configuration error on request) rather than silently defaulting to mock
# -- a production deployment must never serve deterministic mock findings
# as if they were real AI without an explicit, deliberate choice to do so.
# Explicitly setting AI_PROVIDER=mock is still honored even in production.
AI_PROVIDER=mock

# Required only when AI_PROVIDER=openai. Get a key from
# https://platform.openai.com/api-keys. Without a key, AI analysis is
# unavailable -- the server itself starts normally regardless; only an
# actual analysis request reports a configuration error.
OPENAI_API_KEY=replace-with-a-real-openai-api-key
# Optional -- defaults to gpt-5-mini if unset (see integrations/ai/factory.ts).
OPENAI_MODEL=gpt-5-mini

# Stage 18.7: AI cost controls (server/src/modules/ai-analysis/cost-controls.ts).
# A repeated manual analysis of unchanged data is reused for free (no new
# AI call); these limits apply only when a NEW (paid) AI call would happen.
# Invalid values fall back to the defaults below.
# Seconds between paid manual analyses of the SAME item (default 30).
AI_MANUAL_COOLDOWN_SECONDS=30
# Paid manual analyses per user per rolling 24 hours (default 50; 0 = none).
AI_MANUAL_DAILY_LIMIT=50
# Automatic AI analyses (e.g. on a Performance degradation): "true"/"false".
# Unset = ON in development, OFF when NODE_ENV=production.
AI_AUTOMATIC_ENABLED=true

# Selects the email delivery provider (server/src/integrations/email/).
# Stage 17.1: provider integration boundary only -- nothing in the
# codebase calls this yet (no Alert wiring, no worker exist until Stage
# 17.3/17.5). "mock"   -- deterministic, zero-network, zero-cost. Default
# if unset -- safe for local development without a Resend account.
# "resend" -- real Resend API calls. Requires RESEND_API_KEY/EMAIL_FROM
# below. Any other value fails safely with a configuration error when an
# email send is actually requested (the server itself still starts
# normally).
#
# When NODE_ENV=production, an UNSET EMAIL_PROVIDER is refused
# (configuration error on send) rather than silently defaulting to mock --
# a production deployment must never silently discard outbound email
# while reporting success. Explicitly setting EMAIL_PROVIDER=mock is still
# honored even in production (mirrors AI_PROVIDER's identical Stage 16.7
# policy).
EMAIL_PROVIDER=mock

# Required only when EMAIL_PROVIDER=resend. Get a key from
# https://resend.com/api-keys. Without a key, email sending is
# unavailable -- the server itself starts normally regardless; only an
# actual send request reports a configuration error.
RESEND_API_KEY=replace-with-a-real-resend-api-key
# Required only when EMAIL_PROVIDER=resend -- the verified sender address
# Resend is configured to send from.
EMAIL_FROM=replace-with-a-verified-sender-address@example.com
# Optional -- defaults to "Sentinel AI" if unset (see
# integrations/email/factory.ts). Display name only, never an address.
EMAIL_FROM_NAME=Sentinel AI

# The public base URL of the Sentinel AI frontend, used only to build
# links back into the app from email content (modules/email-delivery/
# payload.ts). Must be http:// or https:// -- any other protocol, or an
# URL with embedded credentials, is rejected and the email is sent
# without an action link rather than with a broken/unsafe one.
#
# Unset in development defaults to http://localhost:3000 (the client's
# own dev port). Unset in production (NODE_ENV=production) produces NO
# link at all rather than silently emitting a localhost link in a real
# email -- set this explicitly before relying on email links in
# production.
APP_BASE_URL=http://localhost:3000
